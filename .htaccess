# Заголовки безопасности для страниц сайта.
# Nonce в script-src статический (страница статическая, серверного рендеринга нет): он нужен виджету Jivo,
# который вставляет свой код inline-скриптом. Тот же nonce стоит на тегах <script> в index.html и в CSP-мете там же.
# Если меняете nonce, меняйте его во всех трёх местах.
# Для PHP-скриптов (api/, admin/) заголовки выставляет сам PHP, поэтому CSP здесь только для html.
<IfModule mod_headers.c>
    <FilesMatch "\.html?$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'nonce-3S7tz7WIFqxc2WsLvB_rGO9c' https://code.jivo.ru https://*.jivo.ru https://*.jivosite.com; style-src 'self' 'unsafe-inline' https://*.jivo.ru https://*.jivosite.com; img-src 'self' data: blob: https://*.jivo.ru https://*.jivosite.com; font-src 'self' data: https://*.jivo.ru https://*.jivosite.com; connect-src 'self' https://*.jivo.ru wss://*.jivo.ru https://*.jivosite.com wss://*.jivosite.com; frame-src https://*.jivo.ru https://*.jivosite.com; media-src 'self' https://*.jivo.ru https://*.jivosite.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; frame-ancestors 'none'"
        Header always set X-Frame-Options "DENY"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=()"
    # HSTS только когда соединение действительно по TLS
    Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>

# Скрытые файлы (.git, .gitignore и т. п.) не отдаём
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
</IfModule>

# 3D-модель в формате glTF Binary
<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType font/woff2 .woff2
</IfModule>

# Кэширование статики. HTML не кэшируется, CSS и JS обновляются в течение часа,
# шрифты, картинки и модель живут долго (при замене файла меняйте имя или ждите срок).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType model/gltf-binary "access plus 7 days"
</IfModule>

# Сжатие текстовых ответов, если хостинг не делает этого сам
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

